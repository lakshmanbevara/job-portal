PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/studentjobportal

JWT_SECRET=yoursupersecretjwtkeyhere12345678
JWT_EXPIRE=30d

# Nodemailer SMTP Configuration
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
FROM_NAME=StudentJobPortal
FROM_EMAIL=noreply@studentjobportal.com

# Cloudinary Configuration (Optional - will fallback to local folder)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
